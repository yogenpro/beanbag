{
  "name": "beanbag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --env local",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build && npm run privacy && npm run worker:check",
    "privacy": "node scripts/check-public.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --env local",
    "worker:check": "wrangler deploy --env '' --dry-run --outdir .worker-build",
    "preview": "wrangler dev --ip 127.0.0.1 --env local"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lossless-json": "^4.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.10.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.45.0"
  }
}
